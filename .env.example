# Copy to .env. All optional; a missing key just skips that step and the app tells you.
ALPHAVANTAGE_API_KEY=
OPENROUTER_API_KEY=        # or ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=
SHARPE_MODEL=              # default anthropic/claude-haiku-4.5 (OpenRouter) or claude-haiku-4-5-20251001 (Anthropic)
SEC_EMAIL=you@example.com  # EDGAR asks for a contact in the User-Agent
AV_PAUSE=12                # seconds between uncached Alpha Vantage calls (free tier: 5/min, 25/day)
