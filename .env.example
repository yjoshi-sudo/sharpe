# Copy to .env for local runs. On Vercel, set the same names under Settings -> Environment Variables.
# All optional: a missing key just skips that step and the app tells you.

# Access code for shared deployments (strongly recommended on Vercel)
SHARPE_PASSWORD=

# LLM: set ONE of these
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Model id. Default: anthropic/claude-haiku-4.5 (OpenRouter) or claude-haiku-4-5-20251001 (Anthropic)
SHARPE_MODEL=

# Earnings reports, call transcripts, next-earnings dates (free tier works: 25 calls/day, 5/min)
ALPHAVANTAGE_API_KEY=

# SEC EDGAR asks for a contact address in the User-Agent
SEC_EMAIL=you@example.com
